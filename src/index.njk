---
layout: base.njk
title: Portfolio
---

<!-- HERO -->
<section id="hero" class="section-fullscreen relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent z-10"></div>

  <div class="absolute inset-0 z-0">
    <img src="/images/banner.jpg" alt="Su Erdemir" class="w-full h-full object-cover object-top img-parallax" id="hero-bg">
  </div>

  <div class="relative z-20 w-full px-6 md:px-12 lg:px-20 flex items-end pb-24 md:pb-32 h-full">
    <div class="max-w-2xl">
      <div class="overflow-hidden">
        <h1 id="hero-name" class="font-display text-[60px] leading-[0.95] tracking-tight font-medium">
          Su Erdemir
        </h1>
      </div>
      <div class="overflow-hidden mt-3">
        <p id="hero-tagline" class="text-xs md:text-sm tracking-[0.4em] uppercase font-light text-gray-400">
          Model &middot; Actress &middot; Commercial Talent
        </p>
      </div>

      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-x-12 gap-y-5" id="hero-stats">
        <div>
          <p class="text-[10px] tracking-[0.2em] uppercase text-gray-400 mb-1">Born</p>
          <p class="text-sm font-light">March 14, 2016</p>
        </div>
        <div>
          <p class="text-[10px] tracking-[0.2em] uppercase text-gray-400 mb-1">Based in</p>
          <p class="text-sm font-light">Florida, USA</p>
        </div>
        <div>
          <p class="text-[10px] tracking-[0.2em] uppercase text-gray-400 mb-1">Languages</p>
          <p class="text-sm font-light">English &middot; Turkish</p>
        </div>
        <div>
          <p class="text-[10px] tracking-[0.2em] uppercase text-gray-400 mb-1">Skills</p>
          <p class="text-sm font-light">Acting &middot; Dance &middot; Swimming</p>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-12 left-1/2 -translate-x-1/2 z-20">
    <div id="scroll-indicator" class="flex flex-col items-center gap-3">
      <span class="text-[10px] tracking-[0.3em] uppercase text-gray-400">Scroll</span>
      <div class="w-px h-12 bg-gradient-to-b from-white/60 to-transparent scroll-line"></div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="section-fullscreen py-32">
  <div class="max-w-6xl mx-auto px-6 md:px-12 grid md:grid-cols-2 gap-16 md:gap-24 items-center">

    <div class="relative overflow-hidden aspect-[3/4]" data-speed="0.8">
      <img src="/images/img2.jpg" alt="Su Erdemir — Profile" class="w-full h-full object-cover img-parallax">
    </div>

    <div>
      <div class="overflow-hidden mb-8">
        <p class="text-xs tracking-[0.3em] uppercase text-gray-400 reveal-up">About</p>
      </div>
      <div class="overflow-hidden">
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-medium leading-tight reveal-up">
          Born to<br><em class="font-light">perform.</em>
        </h2>
      </div>
      <div class="mt-8 space-y-4 text-gray-400 text-sm md:text-base leading-relaxed font-light">
        <p class="reveal-up">Su Erdemir is a 10-year-old aspiring talent with a natural presence in front of the camera. With her expressive personality and dedication, she brings energy and authenticity to every project.</p>
        <p class="reveal-up">Whether it's a commercial shoot, a theatrical role, or a fashion editorial — Su's versatility and professionalism set her apart.</p>
      </div>

      <div class="mt-12 grid grid-cols-2 gap-8">
        <div class="stat-item reveal-up">
          <p class="text-xs tracking-[0.2em] uppercase text-gray-400 mb-1">Age</p>
          <p class="font-display text-2xl">10</p>
        </div>
        <div class="stat-item reveal-up">
          <p class="text-xs tracking-[0.2em] uppercase text-gray-400 mb-1">Based in</p>
          <p class="font-display text-2xl">USA</p>
        </div>
        <div class="stat-item reveal-up">
          <p class="text-xs tracking-[0.2em] uppercase text-gray-400 mb-1">Hair</p>
          <p class="font-display text-2xl">Brown</p>
        </div>
        <div class="stat-item reveal-up">
          <p class="text-xs tracking-[0.2em] uppercase text-gray-400 mb-1">Eyes</p>
          <p class="font-display text-2xl">Brown</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<section class="py-16 overflow-hidden border-y border-gray-800">
  <div class="marquee-track flex whitespace-nowrap">
    {% for i in range(0, 8) %}
    <span class="font-display text-6xl md:text-8xl font-medium mx-8 text-gray-800 select-none">Su Erdemir</span>
    <span class="text-6xl md:text-8xl mx-8 text-gray-800 select-none">&middot;</span>
    {% endfor %}
  </div>
</section>

<!-- GALLERY -->
<section id="gallery" class="py-32 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-end mb-16">
      <div>
        <p class="text-xs tracking-[0.3em] uppercase text-gray-400 mb-4 reveal-up">Gallery</p>
        <h2 class="font-display text-4xl md:text-6xl font-medium reveal-up">Portfolio</h2>
      </div>
      <p class="text-xs tracking-[0.2em] uppercase text-gray-400 reveal-up hidden md:block">Selected Work</p>
    </div>

    <!-- Row 1: 3 portraits -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden">
        <img src="/images/img10.jpg" alt="Su Erdemir — Studio Headshot" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden">
        <img src="/images/img5.jpg" alt="Su Erdemir — Dramatic Portrait" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden hidden md:block">
        <img src="/images/img13.jpg" alt="Su Erdemir — Studio Portrait" class="w-full h-full object-cover" loading="lazy">
      </div>
    </div>

    <!-- Row 2: wide + portrait -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 mt-3 md:mt-4">
      <div class="gallery-item aspect-[4/5] reveal-up overflow-hidden md:col-span-2">
        <img src="/images/img6.jpg" alt="Su Erdemir — Behind the Scenes" class="w-full h-full object-cover object-top" loading="lazy">
      </div>
      <div class="gallery-item aspect-[4/5] reveal-up overflow-hidden">
        <img src="/images/img3.jpg" alt="Su Erdemir — Smiling" class="w-full h-full object-cover" loading="lazy">
      </div>
    </div>

    <!-- Row 3: 3 portraits -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 mt-3 md:mt-4">
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden">
        <img src="/images/img8.jpg" alt="Su Erdemir — Outdoor" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden">
        <img src="/images/img11.jpg" alt="Su Erdemir — Smile" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden hidden md:block">
        <img src="/images/img12.jpg" alt="Su Erdemir — Studio Smile" class="w-full h-full object-cover" loading="lazy">
      </div>
    </div>

    <!-- Row 4: portrait + wide -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 mt-3 md:mt-4">
      <div class="gallery-item aspect-[4/5] reveal-up overflow-hidden">
        <img src="/images/img9.jpg" alt="Su Erdemir — Close Up" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="gallery-item aspect-[4/5] reveal-up overflow-hidden md:col-span-2">
        <img src="/images/img7.jpg" alt="Su Erdemir — Hair & Makeup" class="w-full h-full object-cover object-top" loading="lazy">
      </div>
    </div>

    <!-- Row 5: 3 portraits -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 mt-3 md:mt-4">
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden">
        <img src="/images/img4.jpg" alt="Su Erdemir — Lifestyle" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden">
        <img src="/images/img1.jpg" alt="Su Erdemir — Profile" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="gallery-item aspect-[3/4] reveal-up overflow-hidden hidden md:block">
        <img src="/images/img2.jpg" alt="Su Erdemir — Elegant Profile" class="w-full h-full object-cover" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- REEL -->
<section id="reel" class="section-fullscreen relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="/images/img1.jpg" alt="Behind the Scenes" class="w-full h-full object-cover opacity-30 img-parallax">
  </div>
  <div class="relative z-10 text-center px-6">
    <p class="text-xs tracking-[0.3em] uppercase text-gray-400 mb-6 reveal-up">Showreel</p>
    <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-medium mb-12 reveal-up">Watch the<br><em class="font-light">Reel</em></h2>

    <!-- Play button -->
    <div class="reveal-up">
      <button id="play-btn" class="magnetic-btn w-28 h-28 md:w-36 md:h-36 rounded-full border border-white/30 flex items-center justify-center mx-auto hover:bg-white hover:text-black transition-all duration-500 group">
        <svg class="w-8 h-8 ml-1 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    </div>
    <p class="mt-8 text-xs tracking-[0.2em] uppercase text-gray-400 reveal-up">Coming Soon</p>
  </div>
</section>

<!-- RESUME -->
<section id="resume" class="py-32 px-6 md:px-12">
  <div class="max-w-4xl mx-auto">
    <p class="text-xs tracking-[0.3em] uppercase text-gray-400 mb-4 reveal-up">Resume</p>
    <h2 class="font-display text-4xl md:text-6xl font-medium mb-16 reveal-up">Experience<br>& <em class="font-light">Training</em></h2>

    <div class="space-y-0">
      <!-- Resume items -->
      <div class="resume-item border-t border-gray-800 py-8 grid md:grid-cols-3 gap-4 reveal-up">
        <p class="text-xs tracking-[0.2em] uppercase text-gray-400">Training</p>
        <p class="md:col-span-2 font-light">Acting classes & workshops</p>
      </div>
      <div class="resume-item border-t border-gray-800 py-8 grid md:grid-cols-3 gap-4 reveal-up">
        <p class="text-xs tracking-[0.2em] uppercase text-gray-400">Special Skills</p>
        <p class="md:col-span-2 font-light">Bilingual (Turkish & English) &middot; Dance &middot; Swimming</p>
      </div>
      <div class="resume-item border-t border-gray-800 py-8 grid md:grid-cols-3 gap-4 reveal-up">
        <p class="text-xs tracking-[0.2em] uppercase text-gray-400">Type</p>
        <p class="md:col-span-2 font-light">Commercial &middot; Theatrical &middot; Print &middot; Voice Over</p>
      </div>
      <div class="resume-item border-t border-b border-gray-800 py-8 grid md:grid-cols-3 gap-4 reveal-up">
        <p class="text-xs tracking-[0.2em] uppercase text-gray-400">Availability</p>
        <p class="md:col-span-2 font-light">Open to projects nationwide</p>
      </div>
    </div>

    <div class="mt-12 reveal-up">
      <a href="#contact" class="inline-flex items-center gap-3 text-xs tracking-[0.2em] uppercase hover:opacity-50 transition-opacity">
        Download Comp Card
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" class="section-fullscreen py-32">
  <div class="max-w-4xl mx-auto px-6 md:px-12 text-center">
    <p class="text-xs tracking-[0.3em] uppercase text-gray-400 mb-6 reveal-up">Contact</p>
    <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-medium mb-6 reveal-up">Let's <em class="font-light">Work</em><br>Together</h2>
    <p class="text-gray-400 font-light mb-12 reveal-up">For bookings, collaborations, and inquiries</p>

    <div class="reveal-up">
      <a href="mailto:erdemirs@gmail.com" class="magnetic-btn inline-flex items-center gap-4 border border-white/30 rounded-full px-10 py-5 text-sm tracking-[0.15em] uppercase hover:bg-white hover:text-black transition-all duration-500">
        Get in Touch
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <div class="mt-16 flex justify-center gap-8 reveal-up">
      <a href="#" class="text-xs tracking-[0.2em] uppercase text-gray-400 hover:text-white transition-colors">Instagram</a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="py-8 px-6 md:px-12 border-t border-gray-800">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-xs tracking-[0.15em] uppercase text-gray-400">
    <p>&copy; 2026 Su Erdemir</p>
    <p class="font-light">All rights reserved</p>
  </div>
</footer>
