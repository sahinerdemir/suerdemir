<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Su Erdemir</title>
  <meta name="description" content="Su Erdemir — Young talent. Model, actress & commercial artist.">
  <meta property="og:title" content="Su Erdemir — Portfolio">
  <meta property="og:description" content="Young talent. Model, actress & commercial artist.">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/output.css">
</head>
<body>
  <!-- Cursor follower -->
  <div id="cursor" class="fixed w-5 h-5 border border-white/50 rounded-full pointer-events-none z-[9998] mix-blend-difference hidden lg:block" style="transform: translate(-50%, -50%);"></div>

  <!-- Navigation -->
  <nav class="fixed top-0 left-0 w-full z-50 mix-blend-difference px-6 md:px-12 py-6 flex justify-between items-center">
    <a href="#hero" class="font-display text-lg tracking-wider text-white">SE</a>
    <div class="hidden md:flex gap-8 text-xs tracking-[0.2em] uppercase font-light">
      <a href="#about" class="nav-link hover:opacity-50 transition-opacity duration-300 text-white">About</a>
      <a href="#gallery" class="nav-link hover:opacity-50 transition-opacity duration-300 text-white">Gallery</a>
      <a href="#reel" class="nav-link hover:opacity-50 transition-opacity duration-300 text-white">Reel</a>
      <a href="#resume" class="nav-link hover:opacity-50 transition-opacity duration-300 text-white">Resume</a>
      <a href="#contact" class="nav-link hover:opacity-50 transition-opacity duration-300 text-white">Contact</a>
    </div>
    <button id="menu-toggle" class="md:hidden text-white text-xs tracking-[0.2em] uppercase">Menu</button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-black flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-500">
    <a href="#about" class="mobile-nav-link font-display text-3xl text-white">About</a>
    <a href="#gallery" class="mobile-nav-link font-display text-3xl text-white">Gallery</a>
    <a href="#reel" class="mobile-nav-link font-display text-3xl text-white">Reel</a>
    <a href="#resume" class="mobile-nav-link font-display text-3xl text-white">Resume</a>
    <a href="#contact" class="mobile-nav-link font-display text-3xl text-white">Contact</a>
  </div>

  {{ content | safe }}

  <!-- GSAP -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/ScrollToPlugin.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
